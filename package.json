{
  "name": "@osumi/ticketbaiws",
  "version": "1.0.1",
  "description": "Universal TypeScript SDK for the TicketBaiWS API.",
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js"
    }
  },
  "files": [
    "lib/**/*",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "check": "npm run lint && npm run build && npm run test:coverage && npm pack --dry-run && npm run test:package",
    "test:package": "node scripts/test-package.mjs",
    "prepack": "npm run build",
    "prepublishOnly": "npm run check"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/osumionline/ticketbaiws.git"
  },
  "keywords": [
    "ticketbai",
    "ticketbaiws",
    "verifactu",
    "berein",
    "typescript",
    "sdk",
    "osumi"
  ],
  "author": "Iñigo Gorosabel",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/osumionline/ticketbaiws/issues"
  },
  "homepage": "https://github.com/osumionline/ticketbaiws#readme",
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitest/coverage-v8": "^5.0.3",
    "eslint": "^10.12.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3"
  }
}
